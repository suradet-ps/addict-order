{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Addict Order",
  "version": "0.1.0",
  "identifier": "com.suradet.addictorder",
  "build": {
    "beforeDevCommand": { "script": "trunk serve --port 1420", "cwd": "../app" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "trunk build", "cwd": "../app" },
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Addict Order - ใบสั่งจ่าย ย.ส. ๒/ว.จ. ๒",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Medical",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
